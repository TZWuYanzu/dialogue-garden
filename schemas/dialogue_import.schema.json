{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dialogue-garden.local/schemas/dialogue_import.schema.json",
  "title": "Dialogue Garden Normalized Import",
  "type": "object",
  "required": [
    "platform",
    "import_path",
    "title",
    "turns"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "import_path": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "metadata": {
      "type": "object",
      "default": {}
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool",
              "unknown"
            ]
          },
          "author_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "default": {}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
